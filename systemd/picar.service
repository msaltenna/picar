[Unit]
Description=PiCar Control Server
After=network.target
After=mavproxy.service

[Service]
ExecStart=/usr/bin/node /opt/picar/app.js
ExecStopPost=-/usr/bin/killall -q ffmpeg libcamera-vid rpicam-vid
WorkingDirectory=/opt/picar
StandardOutput=inherit
StandardError=inherit
Restart=always
# Without a delay a crash-loop retries every ~100ms, which on a rover means the control
# plane flapping instead of failing visibly. A crash also now runs a fail-safe first; give
# those packets time to leave before the next start races them.
RestartSec=2
KillMode=mixed
KillSignal=SIGINT
TimeoutStopSec=5
User=saltenna
Environment=NODE_ENV=production

[Install] 
WantedBy=multi-user.target
